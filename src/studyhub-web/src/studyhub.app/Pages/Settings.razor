    private static string GetApplyResultMessage(CourseContentSyncApplyResult result)
        => result.Status switch
        {
            CourseContentSyncApplyStatus.Applied => string.IsNullOrWhiteSpace(result.Message)
                ? "Sincronização aplicada com sucesso."
                : result.Message,
            CourseContentSyncApplyStatus.NoChanges => string.IsNullOrWhiteSpace(result.Message)
                ? "Nenhuma alteração estrutural foi necessária."
                : $"Nenhuma alteração estrutural foi necessária. {result.Message}",
            CourseContentSyncApplyStatus.Blocked => $"A sincronização foi bloqueada. {result.Message} Faça uma nova verificação antes de tentar novamente.",
            CourseContentSyncApplyStatus.Failed => string.IsNullOrWhiteSpace(result.Message)
                ? "Não foi possível aplicar a sincronização."
                : result.Message,
            _ => result.Message
        };

    private static string GetPreviewMessage(CourseContentSyncPreviewResult preview)
    {
        if (preview.Status != CourseContentSyncPreviewStatus.NoChanges)
        {
            return preview.Message;
        }

        return string.IsNullOrWhiteSpace(preview.Message)
            ? "O conteúdo já está sincronizado."
            : $"O conteúdo já está sincronizado. {preview.Message}";
    }

    private static string ResolvePlanTitle(string existingTitle, string title, string path)
    {
        if (!string.IsNullOrWhiteSpace(existingTitle))
        {
            return existingTitle;
        }

        return !string.IsNullOrWhiteSpace(title) ? title : path;
    }

    private static string GetActionElementId(Guid courseId, string action)
        => $"storage-{action}-{courseId:N}";

