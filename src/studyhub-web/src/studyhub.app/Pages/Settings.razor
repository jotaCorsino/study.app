            CourseSourceLocationChangeStatus.PartialConfirmationRequired => "Confirmação necessária",
            CourseSourceLocationChangeStatus.Blocked => "Alteração bloqueada",
            CourseSourceLocationChangeStatus.ValidationFailed => "Validação falhou",
