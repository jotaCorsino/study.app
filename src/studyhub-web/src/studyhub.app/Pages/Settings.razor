            CourseSourceLocationCompatibility.PartialMatch => "Correspondência parcial",
            CourseSourceLocationCompatibility.Incompatible => "Pasta incompatível",
            CourseSourceLocationCompatibility.InsufficientReferenceData => "Dados insuficientes",
            _ => "Localização não avaliada"
        };

