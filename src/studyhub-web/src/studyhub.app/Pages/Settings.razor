    private static string FormatLocalDateTime(DateTime value)
    {
        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);
        return utcValue.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm");
    }

    private static string FormatValidationSummary(CourseSourceLocationValidationResult validation)
        => $"Pasta atual: {DisplayPath(validation.CurrentRootPath)}{Environment.NewLine}" +
           $"Pasta selecionada: {DisplayPath(validation.CandidateRootPath)}{Environment.NewLine}" +
           $"Aulas conhecidas: {validation.ExistingLessonCount}{Environment.NewLine}" +
           $"Aulas reconhecidas: {validation.MatchedExistingLessonCount}{Environment.NewLine}" +
           $"Aulas ausentes: {validation.MissingExistingLessonCount}{Environment.NewLine}" +
           $"Novos vídeos: {validation.NewCandidateLessonCount}";

