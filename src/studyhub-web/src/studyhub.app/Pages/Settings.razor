    private async Task CloseDialog(CourseStorageCardState card)
    {
        if (card.IsBusy)
        {
            return;
        }

        var focusElementId = returnFocusElementId;
        activeDialogCourseId = null;
        returnFocusElementId = null;
        await RequestRenderAsync();

        if (!string.IsNullOrWhiteSpace(focusElementId))
        {
            await FocusElementAsync(focusElementId);
        }
    }

    private async Task HandleDialogKeyDownAsync(KeyboardEventArgs eventArgs, CourseStorageCardState card)
    {
        if (string.Equals(eventArgs.Key, "Escape", StringComparison.Ordinal))
        {
            await CloseDialog(card);
        }
    }

    private void HandleControllerChanged()
    {
        _ = RequestRenderAsync();
    }

    private Task RequestRenderAsync()
        => disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    private async Task FocusElementAsync(string elementId)
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("studyHubSettingsFocus.focusById", elementId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
    }

    private static bool ShouldShowLocationResult(CourseStorageCardState card)
    {
        if (card.LocationChangeResult is { Success: false })
        {
            return true;
        }

        return card.LocationChangeResult is null && card.LocationValidation is { } validation &&
            (!validation.Success || validation.Compatibility is
                CourseSourceLocationCompatibility.Incompatible or
                CourseSourceLocationCompatibility.InsufficientReferenceData);
    }

