@using studyhub.application.Interfaces
@using studyhub.domain.Entities
@inject IRoutineService RoutineService

<div class="modal-overlay" @onclick="HandleOverlayClick">
    <div class="modal-content glass-strong p-xl rounded-xl w-full max-w-2xl animate-scale-in" @onclick:stopPropagation="true">
        <div class="modal-header flex justify-between items-center mb-lg">
            <h2 class="text-xl font-bold">Visão de Longo Prazo (@DateTime.Now.Year)</h2>
            <button class="nav-add-course-button" title="Fechar" type="button" @onclick="OnClose">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <div class="modal-body mb-xl">
            @if (isLoading)
            {
                <div class="flex justify-center items-center py-xl">
                    <div class="text-tertiary">Carregando histórico...</div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-4 gap-md">
                    @for (int month = 1; month <= 12; month++)
                    {
                        if (monthSummaries.TryGetValue(month, out var summary))
                        {
                            <div class="month-block @GetColorClassForAverage(summary.AveragePercentage, month) flex flex-col items-center justify-center rounded-lg p-md"
                                 title="@summary.Title">
                                <span class="font-bold text-lg pointer-events-none">@GetMonthAbbreviation(month)</span>
                                <span class="month-block-primary pointer-events-none">@summary.PrimaryMetric</span>
                                <span class="month-block-secondary pointer-events-none">@summary.SecondaryMetric</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public RoutineSettings Settings { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private bool isLoading = true;
    private Dictionary<int, MonthlyRoutineSummary> monthSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var currentYear = DateTime.Now.Year;
        for (int month = 1; month <= 12; month++)
        {
            var evaluations = await RoutineService.GetMonthlyGoalEvaluationsAsync(CourseId, currentYear, month);
            var plannedEvaluations = evaluations
                .Where(evaluation => evaluation.IsPlannedDay)
                .ToList();

            if (month == DateTime.Now.Month)
            {
                plannedEvaluations = plannedEvaluations
                    .Where(evaluation => !evaluation.IsFutureDay)
                    .ToList();
            }

            if (plannedEvaluations.Count == 0 || month > DateTime.Now.Month)
            {
                monthSummaries[month] = MonthlyRoutineSummary.Empty(month);
                continue;
            }

            monthSummaries[month] = MonthlyRoutineSummary.Create(month, plannedEvaluations);
        }

        isLoading = false;
        StateHasChanged();
    }

    private string GetMonthAbbreviation(int month)
    {
        return month switch
        {
            1 => "Jan",
            2 => "Fev",
            3 => "Mar",
            4 => "Abr",
            5 => "Mai",
            6 => "Jun",
            7 => "Jul",
            8 => "Ago",
            9 => "Set",
            10 => "Out",
            11 => "Nov",
            12 => "Dez",
            _ => string.Empty
        };
    }

    private string GetColorClassForAverage(double percentage, int month)
    {
        if (double.IsNaN(percentage) || month > DateTime.Now.Month) return "bg-neutral opacity-50";

        if (percentage < 25) return "bg-level-1";
        if (percentage < 50) return "bg-level-2";
        if (percentage < 75) return "bg-level-3";
        return "bg-level-4";
    }

    private async Task HandleOverlayClick()
    {
        await OnClose.InvokeAsync();
    }

    private sealed record MonthlyRoutineSummary(
        int Month,
        double AveragePercentage,
        int PlannedDays,
        int GoalMetDays,
        int TotalMinutes,
        int TotalStudyUnits,
        bool HasTimeGoals,
        bool HasStudyUnitGoals)
    {
        public string PrimaryMetric
        {
            get
            {
                if (PlannedDays == 0)
                {
                    return "Sem rotina";
                }

                if (HasStudyUnitGoals && !HasTimeGoals)
                {
                    return RoutineGoalDisplayFormatter.FormatStudyUnitCount(TotalStudyUnits);
                }

                if (HasTimeGoals && !HasStudyUnitGoals)
                {
                    return RoutineGoalDisplayFormatter.FormatMinutes(TotalMinutes);
                }

                return $"{GoalMetDays}/{PlannedDays} dias";
            }
        }

        public string SecondaryMetric
        {
            get
            {
                if (PlannedDays == 0)
                {
                    return "Não planejado";
                }

                if (HasStudyUnitGoals && !HasTimeGoals)
                {
                    var average = PlannedDays > 0 ? (double)TotalStudyUnits / PlannedDays : 0;
                    return $"{GoalMetDays}/{PlannedDays} dias | {average:0.#}/dia";
                }

                if (HasTimeGoals && !HasStudyUnitGoals)
                {
                    return $"{GoalMetDays}/{PlannedDays} dias meta";
                }

                return "Histórico misto";
            }
        }

        public string Title
        {
            get
            {
                if (PlannedDays == 0)
                {
                    return $"{GetMonthName(Month)}: sem dias planejados";
                }

                if (HasStudyUnitGoals && !HasTimeGoals)
                {
                    return $"{GetMonthName(Month)}: {RoutineGoalDisplayFormatter.FormatStudyUnitCount(TotalStudyUnits)} concluídos; {GoalMetDays}/{PlannedDays} dias com meta atingida";
                }

                if (HasTimeGoals && !HasStudyUnitGoals)
                {
                    return $"{GetMonthName(Month)}: {RoutineGoalDisplayFormatter.FormatMinutes(TotalMinutes)} estudados; {GoalMetDays}/{PlannedDays} dias com meta atingida";
                }

                return $"{GetMonthName(Month)}: histórico misto; {RoutineGoalDisplayFormatter.FormatMinutes(TotalMinutes)} estudados; {RoutineGoalDisplayFormatter.FormatStudyUnitCount(TotalStudyUnits)} concluídos; {GoalMetDays}/{PlannedDays} dias com meta atingida";
            }
        }

        public static MonthlyRoutineSummary Empty(int month)
        {
            return new MonthlyRoutineSummary(month, double.NaN, 0, 0, 0, 0, false, false);
        }

        public static MonthlyRoutineSummary Create(int month, IReadOnlyCollection<DailyGoalEvaluation> evaluations)
        {
            var plannedEvaluations = evaluations
                .Where(evaluation => evaluation.IsPlannedDay)
                .ToList();
            var timeEvaluations = plannedEvaluations
                .Where(evaluation => evaluation.GoalMode == DailyGoalMode.TimeMinutes)
                .ToList();
            var studyUnitEvaluations = plannedEvaluations
                .Where(evaluation => evaluation.GoalMode == DailyGoalMode.StudyUnits)
                .ToList();

            return new MonthlyRoutineSummary(
                month,
                plannedEvaluations.Average(evaluation => evaluation.EffectiveCompliancePercentage),
                plannedEvaluations.Count,
                plannedEvaluations.Count(evaluation => evaluation.CountsAsEffectiveGoalMet),
                timeEvaluations.Sum(evaluation => evaluation.MinutesStudied),
                studyUnitEvaluations.Sum(evaluation => evaluation.CompletedGoalValue),
                timeEvaluations.Count > 0,
                studyUnitEvaluations.Count > 0);
        }

        private static string GetMonthName(int month)
        {
            return month switch
            {
                1 => "Janeiro",
                2 => "Fevereiro",
                3 => "Março",
                4 => "Abril",
                5 => "Maio",
                6 => "Junho",
                7 => "Julho",
                8 => "Agosto",
                9 => "Setembro",
                10 => "Outubro",
                11 => "Novembro",
                12 => "Dezembro",
                _ => "Mês"
            };
        }
    }
}
