@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using studyhub.application.Interfaces
@using studyhub.app.Components.Routine
@using studyhub.app.state
@using studyhub.domain.Entities
@inject ICourseService CourseService
@inject IProgressService ProgressService
@inject IRoutineService RoutineService
@inject CourseCatalogState CourseCatalogState
@inject NavigationManager Navigation

<div class="nav-brand">
    <div class="nav-brand-title text-gradient">StudyHub</div>
    <div class="nav-brand-subtitle">Centro de Estudos</div>
</div>

<div class="nav-section">
    <div class="nav-section-title">Principal</div>

    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
        <span class="nav-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
        </span>
        Catalogo
    </NavLink>
</div>

<div class="nav-section mt-md nav-course-scroll">
    <div class="flex justify-between items-center mb-xs px-md">
        <div class="nav-section-title mb-0">Meus Cursos</div>
        <button class="nav-add-course-button" title="Adicionar curso" type="button" @onclick="AddCourse">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </button>
    </div>

    @if (courses.Count > 0)
    {
        @foreach (var group in GetCourseGroups())
        {
            <div class="nav-course-group">
                <div class="nav-course-group-title">@group.Title</div>

                @foreach (var course in group.Courses)
                {
                    var isActive = IsCourseActive(course.Id);
                    var dailyIndicator = GetDailyIndicator(course.Id);

                    <div class="nav-course-row">
                        <button type="button"
                                class="nav-item nav-course-link @(isActive ? "active" : string.Empty)"
                                title="@dailyIndicator.Text"
                                @onclick="() => NavigateToCourse(course.Id)">
                            <span class="nav-course-daily-indicator @dailyIndicator.CssClass" aria-hidden="true"></span>
                            <span class="nav-icon text-tertiary">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <span class="nav-course-text">
                                <span class="truncate text-sm">@course.Title</span>
                                <span class="nav-course-daily-summary">@dailyIndicator.Text</span>
                            </span>
                        </button>

                        <button type="button"
                                class="nav-course-action @(openCourseMenuId == course.Id ? "visible" : string.Empty)"
                                title="Gerenciar curso"
                                @onclick="() => ToggleCourseMenu(course.Id)"
                                @onclick:stopPropagation="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="1"></circle>
                                <circle cx="19" cy="12" r="1"></circle>
                                <circle cx="5" cy="12" r="1"></circle>
                            </svg>
                        </button>

                        @if (openCourseMenuId == course.Id)
                        {
                            <div class="nav-course-menu">
                                <button type="button"
                                        class="nav-course-menu-item danger"
                                        @onclick="() => ConfirmRemoveCourseAsync(course)"
                                        @onclick:stopPropagation="true">
                                    Remover curso
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="nav-empty-state px-md py-md text-sm text-tertiary">
            Nenhum curso disponivel.
        </div>
    }
</div>

<div class="nav-footer">
    <NavLink class="nav-item" href="/settings">
        <span class="nav-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
        </span>
        Configurações
    </NavLink>
</div>

@code {
    private List<Course> courses = [];
    private Guid? openCourseMenuId;
    private readonly Dictionary<Guid, DailyRoutineIndicator> dailyIndicatorByCourseId = [];

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        CourseCatalogState.Changed += HandleCatalogChanged;
        ProgressService.DailyProgressChanged += HandleDailyProgressChanged;
        await LoadCoursesAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        CourseCatalogState.Changed -= HandleCatalogChanged;
        ProgressService.DailyProgressChanged -= HandleDailyProgressChanged;
    }

    private async Task LoadCoursesAsync()
    {
        courses = await CourseService.GetAllCoursesAsync();
        await LoadDailyIndicatorsAsync(courses.Select(course => course.Id).ToList());
        StateHasChanged();
    }

    private async Task LoadDailyIndicatorsAsync(IReadOnlyCollection<Guid> courseIds)
    {
        dailyIndicatorByCourseId.Clear();

        if (courseIds.Count == 0)
        {
            return;
        }

        var today = DateTime.Now.Date;
        foreach (var courseId in courseIds)
        {
            var evaluation = await GetTodayEvaluationAsync(courseId, today);
            dailyIndicatorByCourseId[courseId] = ResolveDailyIndicator(evaluation);
        }
    }

    private List<CourseNavGroup> GetCourseGroups()
    {
        var groups = new List<CourseNavGroup>();
        AddCourseGroup(groups, "Ativos", CourseLifecycleStatus.Active);
        AddCourseGroup(groups, "Pausados", CourseLifecycleStatus.Paused);
        AddCourseGroup(groups, "Concluidos", CourseLifecycleStatus.Completed);
        return groups;
    }

    private void AddCourseGroup(List<CourseNavGroup> groups, string title, CourseLifecycleStatus status)
    {
        var groupCourses = courses
            .Where(course => course.LifecycleStatus == status)
            .ToList();

        if (groupCourses.Count > 0)
        {
            groups.Add(new CourseNavGroup(title, groupCourses));
        }
    }

    private DailyRoutineIndicator GetDailyIndicator(Guid courseId)
    {
        return dailyIndicatorByCourseId.TryGetValue(courseId, out var indicator)
            ? indicator
            : DailyRoutineIndicator.Empty;
    }

    private static DailyRoutineIndicator ResolveDailyIndicator(DailyGoalEvaluation? evaluation)
    {
        var text = RoutineGoalDisplayFormatter.FormatNavMenuIndicator(evaluation);
        if (evaluation is null || !evaluation.IsPlannedDay || evaluation.RawStatus == DailyStudyStatus.Unplanned)
        {
            return new DailyRoutineIndicator("daily-indicator-neutral", text);
        }

        if (evaluation.CompletedGoalValue <= 0)
        {
            return new DailyRoutineIndicator("daily-indicator-level-0", text);
        }

        if (evaluation.CountsAsEffectiveGoalMet)
        {
            return new DailyRoutineIndicator("daily-indicator-level-4", text);
        }

        var percentage = evaluation.RawCompliancePercentage;
        if (percentage < 25)
        {
            return new DailyRoutineIndicator("daily-indicator-level-1", text);
        }

        if (percentage < 50)
        {
            return new DailyRoutineIndicator("daily-indicator-level-2", text);
        }

        if (percentage < 75)
        {
            return new DailyRoutineIndicator("daily-indicator-level-3", text);
        }

        return new DailyRoutineIndicator("daily-indicator-level-4", text);
    }

    private void AddCourse()
    {
        openCourseMenuId = null;
        Navigation.NavigateTo("/add-course");
    }

    private void NavigateToCourse(Guid courseId)
    {
        openCourseMenuId = null;
        Navigation.NavigateTo($"/course/{courseId}");
    }

    private void ToggleCourseMenu(Guid courseId)
    {
        openCourseMenuId = openCourseMenuId == courseId ? null : courseId;
    }

    private bool IsCourseActive(Guid courseId)
    {
        return TryGetCurrentCourseId(out var currentCourseId) && currentCourseId == courseId;
    }

    private bool TryGetCurrentCourseId(out Guid courseId)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 && string.Equals(segments[0], "course", StringComparison.OrdinalIgnoreCase) && Guid.TryParse(segments[1], out courseId))
        {
            return true;
        }

        courseId = Guid.Empty;
        return false;
    }

    private async Task ConfirmRemoveCourseAsync(Course course)
    {
        openCourseMenuId = null;

        var currentPage = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault()?.Page;
        if (currentPage == null)
        {
            return;
        }

        var confirmed = await currentPage.DisplayAlertAsync(
            "Remover curso",
            $"Deseja remover \"{course.Title}\" do aplicativo? Esta acao e irreversivel no contexto do StudyHub e excluira progresso e dados persistidos do curso. Os arquivos fisicos do disco nao serao apagados.",
            "Remover",
            "Cancelar");

        if (!confirmed)
        {
            return;
        }

        var removedCourseId = course.Id;
        await CourseService.DeleteCourseAsync(removedCourseId);

        if (TryGetCurrentCourseId(out var currentCourseId) && currentCourseId == removedCourseId)
        {
            Navigation.NavigateTo("/");
        }

        await LoadCoursesAsync();
        CourseCatalogState.NotifyChanged();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        openCourseMenuId = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleCatalogChanged()
    {
        _ = InvokeAsync(LoadCoursesAsync);
    }

    private void HandleDailyProgressChanged(Guid courseId)
    {
        _ = InvokeAsync(() => RefreshDailyIndicatorAsync(courseId));
    }

    private async Task RefreshDailyIndicatorAsync(Guid courseId)
    {
        if (courseId == Guid.Empty || !courses.Any(course => course.Id == courseId))
        {
            return;
        }

        var today = DateTime.Now.Date;
        var evaluation = await GetTodayEvaluationAsync(courseId, today);
        dailyIndicatorByCourseId[courseId] = ResolveDailyIndicator(evaluation);
        StateHasChanged();
    }

    private async Task<DailyGoalEvaluation?> GetTodayEvaluationAsync(Guid courseId, DateTime today)
    {
        if (courseId == Guid.Empty)
        {
            return null;
        }

        var evaluations = await RoutineService.GetMonthlyGoalEvaluationsAsync(courseId, today.Year, today.Month);
        return evaluations.FirstOrDefault(evaluation => evaluation.Date.Date == today.Date);
    }

    private sealed record CourseNavGroup(string Title, IReadOnlyList<Course> Courses);

    private sealed record DailyRoutineIndicator(string CssClass, string Text)
    {
        public static DailyRoutineIndicator Empty { get; } = new("daily-indicator-neutral", "Hoje: sem meta");
    }
}
