@using studyhub.domain.Entities
@using studyhub.shared.Enums

@{
    var totalLessons = GetTotalLessons();
    var completedLessons = GetCompletedLessons();
    var availabilityState = CourseAvailabilityPresentationHelper.GetModuleState(Module);
    var unavailableDescendantCount = CourseAvailabilityPresentationHelper.CountUnavailableDescendants(Module);
}

<div class="module-accordion @(isOpen ? "open" : "") @(IsActive ? "active" : "") @GetAvailabilityClass(availabilityState)">
    <button type="button"
            class="module-accordion-header"
            aria-expanded="@isOpen.ToString().ToLowerInvariant()"
            aria-controls="@ContentElementId"
            @onclick="Toggle">
        <span class="module-accordion-left">
            <span class="module-accordion-number">@ModuleNumber</span>
            <span class="module-accordion-content">
                <span class="module-accordion-title">@Module?.Title</span>
                <span class="module-accordion-progress @(IsModuleCompleted(completedLessons, totalLessons) ? "module-accordion-progress-completed" : string.Empty)">
                    @completedLessons / @totalLessons concluidas
                </span>
                <span class="module-accordion-meta">
                    @totalLessons aulas - @FormatDuration(GetTotalDurationMinutes())
                </span>
                @if (availabilityState == ModuleAvailabilityPresentationState.Unavailable)
                {
                    <span class="badge badge-warning availability-badge module-availability-badge"
                          title="Este módulo não foi encontrado na última sincronização.">
                        Módulo indisponível
                    </span>
                }
                else if (availabilityState == ModuleAvailabilityPresentationState.PartiallyUnavailable)
                {
                    <span class="badge badge-warning availability-badge module-availability-badge"
                          title="Este módulo possui tópicos ou aulas que não foram encontrados na última sincronização.">
                        @FormatUnavailableItems(unavailableDescendantCount)
                    </span>
                }
            </span>
        </span>
        <span class="module-accordion-right">
            <svg class="module-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </span>
    </button>
    
    <div id="@ContentElementId"
         class="module-accordion-body @(EnableInternalScroll ? "scrollable" : string.Empty)"
         inert="@(!isOpen ? "inert" : null)"
         aria-hidden="@(!isOpen).ToString().ToLowerInvariant()">
        @if (Module?.Topics != null)
        {
            @foreach (var topic in Module.Topics.OrderBy(t => t.Order))
            {
                <LessonList Topic="@topic"
                            LessonStatuses="@LessonStatuses"
                            ActiveLessonId="@ActiveLessonId"
                            OnLessonSelected="@OnLessonSelected" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public int ModuleNumber { get; set; }
    [Parameter, EditorRequired] public Module Module { get; set; } = default!;
    [Parameter] public Dictionary<Guid, LessonStatus> LessonStatuses { get; set; } = new();
    [Parameter] public Guid? ActiveLessonId { get; set; }
    [Parameter] public EventCallback<Lesson> OnLessonSelected { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool EnableInternalScroll { get; set; }

    private bool isOpen;
    private Guid lastModuleId;
    private Guid? lastActiveLessonId;
    
    private bool IsActive => ActiveLessonId.HasValue && Module?.Topics != null && Module.Topics.Any(t => t.Lessons != null && t.Lessons.Any(l => l.Id == ActiveLessonId.Value));
    private string ContentElementId => $"module-content-{Module.Id:N}";

    protected override void OnParametersSet()
    {
        var moduleChanged = lastModuleId != Module.Id;
        var activeLessonChanged = lastActiveLessonId != ActiveLessonId;
        if (moduleChanged || activeLessonChanged)
        {
            isOpen = IsOpen;
        }

        lastModuleId = Module.Id;
        lastActiveLessonId = ActiveLessonId;
    }

    private void Toggle()
    {
        isOpen = !isOpen;
    }

    private int GetCompletedLessons()
    {
        if (Module?.Topics == null) return 0;
        
        return Module.Topics.Sum(t => t.Lessons?.Count(l => 
            LessonStatuses.TryGetValue(l.Id, out var status) && status == LessonStatus.Completed) ?? 0);
    }

    private int GetTotalLessons()
    {
        return Module?.Topics?.Sum(t => t.Lessons?.Count ?? 0) ?? 0;
    }

    private static bool IsModuleCompleted(int completedLessons, int totalLessons)
    {
        return totalLessons > 0 && completedLessons == totalLessons;
    }

    private int GetTotalDurationMinutes()
    {
        return Module?.Topics?.Sum(t => t.Lessons?.Sum(l => (int)l.Duration.TotalMinutes) ?? 0) ?? 0;
    }

    private string FormatDuration(int totalMinutes)
    {
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        if (hours > 0)
        {
            return minutes > 0 ? $"{hours}h {minutes}m" : $"{hours}h";
        }
        return $"{minutes}m";
    }

    private static string GetAvailabilityClass(ModuleAvailabilityPresentationState state)
    {
        return state switch
        {
            ModuleAvailabilityPresentationState.Unavailable => "module-unavailable",
            ModuleAvailabilityPresentationState.PartiallyUnavailable => "module-partially-unavailable",
            _ => string.Empty
        };
    }

    private static string FormatUnavailableItems(int count)
    {
        return count == 1 ? "1 item indisponível" : $"{count} itens indisponíveis";
    }
}
